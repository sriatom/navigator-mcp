# systemd user unit: atlas-mcp over HTTPS with logins (navigator_gate). Install: docs/HTTPS.md.
[Unit]
Description=ATLAS MCP server over HTTPS (port 8792)
After=network-online.target atlas-link.service
Wants=atlas-link.service

[Service]
ExecStart=%h/navigator/.venv/bin/atlas-mcp --serve
Environment=NAVIGATOR_BOOTSTRAP=%h/.config/navigator/navigator.yml
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
